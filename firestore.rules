rules_version = '2';

// Sicherheitsregeln: Nur ihr zwei könnt eure Daten lesen und schreiben.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isMember(coupleId) {
      return signedIn() &&
        get(/databases/$(database)/documents/couples/$(coupleId)).data.members.hasAny([request.auth.uid]);
    }

    // Wie isMember, aber mit dem Zustand NACH dem aktuellen Schreibvorgang (für Batches).
    function isMemberAfter(coupleId) {
      return getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.members.hasAny([request.auth.uid]);
    }

    // Eigenes Profil. coupleId darf nur auf ein Paar zeigen, in dem man wirklich Mitglied ist.
    // Lesen dürfen man selbst und die Person im selben Paar (für Name und Profilbild).
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (resource.data.get('coupleId', null) != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coupleId', null)
            == resource.data.coupleId)
      );
      allow create, update: if signedIn() && request.auth.uid == uid &&
        (!('coupleId' in request.resource.data) || isMemberAfter(request.resource.data.coupleId));
    }

    // Push-Adressen der eigenen Geräte: nur man selbst darf sie lesen und schreiben.
    // (Die Cloud-Funktion liest sie mit Admin-Rechten, die ignorieren diese Regeln.)
    match /users/{uid}/tokens/{token} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /couples/{coupleId} {
      allow read: if isMember(coupleId);
      // Neues Paar: nur man selbst als Mitglied.
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid] &&
        request.resource.data.keys().hasOnly(['members', 'inviteCode', 'createdAt']) &&
        request.resource.data.inviteCode is string &&
        request.resource.data.inviteCode.size() >= 4 && request.resource.data.inviteCode.size() <= 12;
      // Beitreten: genau eine Person kommt dazu, sonst ändert sich nichts.
      allow update: if signedIn() &&
        resource.data.members.size() == 1 &&
        request.resource.data.members == resource.data.members.concat([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      // To-dos: beide dürfen alles (anlegen, abhaken, bearbeiten, löschen), aber nur gültige Daten.
      match /todos/{todoId} {
        function validTodo(d) {
          return d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
            d.assignee is string && d.assignee.size() <= 40 &&
            d.done is bool &&
            (d.get('due', null) == null ||
              (d.due is string && d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
        }
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) && validTodo(request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(coupleId) && validTodo(request.resource.data) &&
          request.resource.data.createdBy == resource.data.createdBy;
      }

      // Countdowns: gleiche Regeln; Datum "2026-11-06", Emoji kurz.
      match /countdowns/{countdownId} {
        function validCountdown(d) {
          return d.title is string && d.title.size() > 0 && d.title.size() <= 100 &&
            d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            d.emoji is string && d.emoji.size() <= 16 &&
            d.yearly is bool;
        }
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) && validCountdown(request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(coupleId) && validCountdown(request.resource.data) &&
          request.resource.data.createdBy == resource.data.createdBy;
      }

      // Fotoalben: beide dürfen Alben anlegen, umbenennen, löschen und Fotos hinzufügen.
      // Am Album selbst ändern sich nur Name, Titelbild und Fotozähler.
      match /albums/{albumId} {
        function validName(d) {
          return d.name is string && d.name.size() > 0 && d.name.size() <= 60;
        }
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) && validName(request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(coupleId) && validName(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'coverUrl', 'photoCount']);

        match /photos/{photoId} {
          allow read, delete: if isMember(coupleId);
          allow create: if isMember(coupleId) &&
            request.resource.data.addedBy == request.auth.uid &&
            request.resource.data.url is string &&
            request.resource.data.url.matches('https://firebasestorage[.]googleapis[.]com/.*') &&
            request.resource.data.path is string;
        }
      }

      // Termine: gleiche Regeln; Datum "2026-11-06", Zeit "07:40", Ende nicht vor Anfang.
      match /events/{eventId} {
        function validEvent(d) {
          return d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
            d.who is string && d.who.size() <= 40 &&
            d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            d.endDate >= d.startDate &&
            (d.get('startTime', null) == null || d.startTime.matches('^[0-9]{2}:[0-9]{2}$')) &&
            (d.get('endTime', null) == null || d.endTime.matches('^[0-9]{2}:[0-9]{2}$')) &&
            d.get('note', '').size() <= 500;
        }
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) && validEvent(request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(coupleId) && validEvent(request.resource.data) &&
          request.resource.data.createdBy == resource.data.createdBy;
      }

      // Frage des Tages: am Tag steht nur, wer schon geantwortet hat.
      // Man darf sich nur selbst in "answered" eintragen.
      match /days/{day} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) &&
          request.resource.data.keys().hasOnly(['question', 'answered']) &&
          request.resource.data.question is string &&
          request.resource.data.question.size() <= 300 &&
          request.resource.data.answered is list &&
          request.resource.data.answered.size() <= 2 &&
          request.resource.data.answered.toSet()
            .difference(resource == null ? [].toSet() : resource.data.answered.toSet())
            .hasOnly([request.auth.uid]);

        // Antworten: die eigene immer; die des Schatzes erst, wenn die eigene existiert.
        match /answers/{uid} {
          allow read: if isMember(coupleId) && (request.auth.uid == uid ||
            exists(/databases/$(database)/documents/couples/$(coupleId)/days/$(day)/answers/$(request.auth.uid)));
          allow create, update: if isMember(coupleId) && request.auth.uid == uid &&
            request.resource.data.keys().hasOnly(['text', 'at']) &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        }
      }

      // Liebesbriefe: den Umschlag sehen beide. Den Text gibt es erst ab openAt
      // (die schreibende Person darf ihren Brief immer lesen).
      match /letters/{letterId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) &&
          request.resource.data.keys().hasOnly(['from', 'to', 'openAt', 'createdAt']) &&
          request.resource.data.from == request.auth.uid &&
          request.resource.data.to is string &&
          request.resource.data.openAt is timestamp &&
          // Ein Brief öffnet sich immer später, nie sofort.
          request.resource.data.openAt > request.time &&
          request.resource.data.createdAt == request.time;
        // Nur die Empfängerin darf "geöffnet" setzen – und erst ab openAt.
        allow update: if isMember(coupleId) &&
          resource.data.to == request.auth.uid &&
          resource.data.openAt <= request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt']);
        allow delete: if isMember(coupleId) && resource.data.from == request.auth.uid;

        match /content/{doc} {
          allow read: if isMember(coupleId) && (
            get(/databases/$(database)/documents/couples/$(coupleId)/letters/$(letterId)).data.from == request.auth.uid ||
            get(/databases/$(database)/documents/couples/$(coupleId)/letters/$(letterId)).data.openAt <= request.time);
          allow create: if isMember(coupleId) &&
            getAfter(/databases/$(database)/documents/couples/$(coupleId)/letters/$(letterId)).data.from == request.auth.uid &&
            request.resource.data.keys().hasOnly(['text']) &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000;
          allow delete: if isMember(coupleId) &&
            get(/databases/$(database)/documents/couples/$(coupleId)/letters/$(letterId)).data.from == request.auth.uid;
        }
      }

      // Date-Glas: eigene Ideen; beide dürfen hineinlegen und herausnehmen.
      match /dateIdeas/{ideaId} {
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) &&
          request.resource.data.keys().hasOnly(['text', 'createdBy', 'createdAt']) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200;
      }

      // Laternenhimmel ("Ich denk an dich"): beide lesen, jede Person schickt nur
      // eigene Laternen. Laternen bleiben für immer – kein Ändern oder Löschen.
      match /lanterns/{lanternId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) &&
          request.resource.data.keys().hasOnly(['from', 'createdAt']) &&
          request.resource.data.from == request.auth.uid &&
          request.resource.data.createdAt == request.time;
      }

      // Schiffe versenken. Die Schüsse wertet die Cloud Function onBattleShot aus
      // (Admin-Rechte, ignoriert diese Regeln). Flotten sieht nur die Besitzerin.
      match /battleships/{gameId} {
        function gamePath() {
          return /databases/$(database)/documents/couples/$(coupleId)/battleships/$(gameId);
        }
        function game() { return get(gamePath()).data; }
        function partnerIn(players) {
          return players[0] == request.auth.uid ? players[1] : players[0];
        }

        allow read: if isMember(coupleId);
        // Neues Spiel: man selbst zuerst in players, der Schatz als zweites.
        allow create: if isMember(coupleId) &&
          request.resource.data.keys().hasOnly(
            ['status', 'players', 'turn', 'resolving', 'createdBy', 'createdAt', 'updatedAt', 'sunk']) &&
          request.resource.data.status == 'setup' &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.players is list &&
          request.resource.data.players.size() == 2 &&
          request.resource.data.players[0] == request.auth.uid &&
          request.resource.data.players[1] != request.auth.uid &&
          get(/databases/$(database)/documents/couples/$(coupleId)).data.members
            .hasAll(request.resource.data.players) &&
          request.resource.data.turn == null &&
          request.resource.data.resolving == false &&
          request.resource.data.sunk == {} &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if isMember(coupleId) && request.auth.uid in resource.data.players && (
          // Schiessen: zusammen mit dem Schuss "Auswertung läuft" setzen (siehe shots).
          (resource.data.status == 'playing' &&
            resource.data.turn == request.auth.uid &&
            resource.data.resolving == false &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolving']) &&
            request.resource.data.resolving == true) ||
          // Notausgang: hängt die Auswertung über eine Minute, darf man sie lösen.
          (resource.data.resolving == true &&
            request.time > resource.data.updatedAt + duration.value(60, 's') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolving']) &&
            request.resource.data.resolving == false) ||
          // Aufgeben: der Schatz gewinnt.
          (resource.data.status in ['setup', 'playing'] &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'winner', 'turn', 'updatedAt']) &&
            request.resource.data.status == 'done' &&
            request.resource.data.winner == partnerIn(resource.data.players) &&
            request.resource.data.turn == null &&
            request.resource.data.updatedAt == request.time)
        );

        // Eigene Flotte: nur man selbst liest und schreibt, nur vor Spielbeginn.
        // Ob die Schiffe gültig liegen, prüft die Cloud Function onBattleFleet.
        match /fleets/{uid} {
          allow read: if request.auth.uid == uid && isMember(coupleId);
          allow create, update: if request.auth.uid == uid && isMember(coupleId) &&
            uid in game().players &&
            game().status == 'setup' &&
            request.resource.data.keys().hasOnly(['ships']) &&
            request.resource.data.ships is list &&
            request.resource.data.ships.size() == 5;
        }

        // Schüsse: nur wer am Zug ist, ein Feld nur einmal (ID by_x_y), kein Ändern/Löschen.
        match /shots/{shotId} {
          allow read: if isMember(coupleId);
          allow create: if isMember(coupleId) &&
            game().status == 'playing' &&
            game().turn == request.auth.uid &&
            game().resolving == false &&
            getAfter(gamePath()).data.resolving == true &&
            request.resource.data.keys().hasOnly(['by', 'x', 'y', 'at']) &&
            request.resource.data.by == request.auth.uid &&
            request.resource.data.x is int && request.resource.data.x >= 0 && request.resource.data.x <= 9 &&
            request.resource.data.y is int && request.resource.data.y >= 0 && request.resource.data.y <= 9 &&
            request.resource.data.at == request.time &&
            shotId == request.auth.uid + '_' + string(request.resource.data.x) + '_' +
              string(request.resource.data.y);
        }
      }

      // Kreuzworträtsel, gemeinsam gelöst: abwechselnd ein Wort (oder ein Hinweis).
      // Die Lösung steht im Dokument – ihr spielt zusammen, nicht gegeneinander.
      match /crosswords/{gameId} {
        function members() {
          return get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) &&
          request.resource.data.keys().hasOnly(
            ['status', 'turn', 'createdBy', 'createdAt', 'updatedAt', 'size', 'words',
             'solved', 'attempts', 'hintsUsed', 'revealed', 'difficulty']) &&
          request.resource.data.get('difficulty', 'medium') in ['veryEasy', 'easy', 'medium', 'hard', 'expert', 'god'] &&
          request.resource.data.status == 'playing' &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.turn == request.auth.uid &&
          request.resource.data.size is int &&
          request.resource.data.size >= 5 && request.resource.data.size <= 15 &&
          request.resource.data.words is list &&
          request.resource.data.words.size() >= 4 && request.resource.data.words.size() <= 20 &&
          request.resource.data.solved == {} &&
          request.resource.data.attempts == 0 &&
          request.resource.data.hintsUsed == 0 &&
          // «Sehr leicht» schenkt zum Start bis zu 4 Buchstaben, «Einfach» 2.
          request.resource.data.revealed is list &&
          request.resource.data.revealed.size() <=
            (request.resource.data.get('difficulty', 'medium') == 'veryEasy' ? 4 : 2) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        // Zug: nur wer dran ist; danach ist der Schatz dran. Gelöste Wörter bleiben gelöst.
        allow update: if isMember(coupleId) &&
          resource.data.status == 'playing' &&
          resource.data.turn == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['solved', 'attempts', 'hintsUsed', 'revealed', 'turn', 'status', 'lastMove', 'updatedAt']) &&
          // Der letzte Zug trägt immer den eigenen Namen.
          (!('lastMove' in request.resource.data) ||
            (request.resource.data.lastMove.by == request.auth.uid &&
             request.resource.data.lastMove.type in ['solved', 'miss', 'hint'])) &&
          request.resource.data.status in ['playing', 'done'] &&
          request.resource.data.turn != request.auth.uid &&
          members().hasAny([request.resource.data.turn]) &&
          request.resource.data.solved is map &&
          request.resource.data.solved.diff(resource.data.solved).removedKeys().size() == 0 &&
          request.resource.data.solved.diff(resource.data.solved).changedKeys().size() == 0 &&
          request.resource.data.attempts is int &&
          request.resource.data.attempts >= resource.data.attempts &&
          request.resource.data.revealed is list &&
          request.resource.data.revealed.hasAll(resource.data.revealed) &&
          request.resource.data.updatedAt == request.time;
      }

      // Verstecktes Kanji des Tages: jede Person trägt nur sich selbst als
      // «gefunden» ein (mit Serverzeit), nichts wird gelöscht.
      match /eggs/{day} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) &&
          day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          request.resource.data.keys().hasOnly(['found']) &&
          request.resource.data.found is map &&
          request.resource.data.found
            .diff(resource == null ? {} : resource.data.found)
            .affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.found[request.auth.uid] == request.time;
      }

      // "schreibt…"-Anzeige: lesen beide, schreiben nur das eigene Dokument.
      match /typing/{uid} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && request.auth.uid == uid &&
          (request.method == 'delete' || request.resource.data.keys().hasOnly(['at']));
      }

      match /messages/{messageId} {
        allow read: if isMember(coupleId);
        // Text (bis 5000 Zeichen), Foto, GIF (GIPHY oder Storage), Sprach- oder
        // Videonachricht oder Datei.
        allow create: if isMember(coupleId) &&
          request.resource.data.senderId == request.auth.uid &&
          (
            (request.resource.data.get('type', 'text') == 'text' &&
              request.resource.data.text is string &&
              request.resource.data.text.size() <= 5000) ||
            (request.resource.data.type == 'image' &&
              request.resource.data.imageUrl is string &&
              request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')) ||
            (request.resource.data.type == 'gif' &&
              request.resource.data.gifUrl is string &&
              request.resource.data.gifUrl.matches('https://((media[0-9]*|i)[.]giphy[.]com|firebasestorage[.]googleapis[.]com)/.*')) ||
            (request.resource.data.type == 'audio' &&
              request.resource.data.audioUrl is string &&
              request.resource.data.audioUrl.matches('https://firebasestorage[.]googleapis[.]com/.*') &&
              request.resource.data.durationMs is int) ||
            (request.resource.data.type == 'video' &&
              request.resource.data.videoUrl is string &&
              request.resource.data.videoUrl.matches('https://firebasestorage[.]googleapis[.]com/.*') &&
              request.resource.data.durationMs is int) ||
            (request.resource.data.type == 'file' &&
              request.resource.data.fileUrl is string &&
              request.resource.data.fileUrl.matches('https://firebasestorage[.]googleapis[.]com/.*') &&
              request.resource.data.fileName is string &&
              request.resource.data.fileName.size() > 0 &&
              request.resource.data.fileName.size() <= 200 &&
              request.resource.data.fileSize is int)
          );
        allow update: if isMember(coupleId) && (
          // Lesebestätigung: nur die Empfängerin darf "gelesen" setzen, sonst ändert sich nichts.
          (resource.data.senderId != request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
            request.resource.data.read == true) ||
          // Bearbeiten: nur eigene Textnachrichten, nur Text und Zeitstempel ändern sich.
          (resource.data.senderId == request.auth.uid &&
            resource.data.get('type', 'text') == 'text' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
            request.resource.data.text is string &&
            request.resource.data.text.size() <= 5000) ||
          // Löschen: nur eigene Nachrichten; der Inhalt wird entfernt, type wird 'deleted'.
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.type == 'deleted' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['type', 'text', 'imageUrl', 'gifUrl', 'audioUrl', 'videoUrl',
               'durationMs', 'reactions', 'replyTo', 'editedAt'])) ||
          // Smiley-Reaktion: jede Person darf nur ihre eigene setzen oder entfernen.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
            request.resource.data.reactions
              .diff(resource.data.get('reactions', {}))
              .affectedKeys().hasOnly([request.auth.uid]) &&
            (!(request.auth.uid in request.resource.data.reactions) ||
              (request.resource.data.reactions[request.auth.uid] is string &&
               request.resource.data.reactions[request.auth.uid].size() <= 16)))
        );
      }
    }

    // Einladungscodes: Wer den Code kennt, darf ihn nachschlagen (aber nicht auflisten).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['coupleId']) &&
        request.resource.data.coupleId is string &&
        isMemberAfter(request.resource.data.coupleId);
      // Codes bleiben unveränderlich (kein update/delete).
    }
  }
}
